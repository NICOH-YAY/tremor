{
  "name": "tremor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5191",
    "build": "vite build --base ./",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "eval:live": "tsx scripts/eval.ts --live",
    "engine:test": "node engine/build/test.mjs",
    "engine:wad": "python scripts/build-tremor-wad.py",
    "engine:build": "python engine/build/build.py"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
