{
  "name": "tremor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5191",
    "build": "vite build --base ./",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node --import ./scripts/typescript-loader.mjs scripts/eval.ts",
    "eval:live": "node --import ./scripts/typescript-loader.mjs scripts/eval.ts --live",
    "engine:test": "node engine/build/test.mjs",
    "engine:wad": "python scripts/build-tremor-wad.py",
    "engine:build": "python engine/build/build.py",
    "engine:headless": "python engine/build/headless.py",
    "engine:headless:test": "python engine/build/headless.py --test",
    "demo:live": "node --import ./scripts/typescript-loader.mjs scripts/demo-live.ts --live",
    "demo:copy": "node scripts/copy-demo.mjs",
    "upstream:patch": "node scripts/upstream-patch.mjs",
    "record:video": "node scripts/record-video.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
